# Copy to `.env` and fill in. `pylon dev` loads `.env` automatically.
# The app runs fine without these in dev — magic codes return dev_code in the
# response and email sends are stubbed.

# ── Email (stack0) ───────────────────────────────────────────────────────────
# Powers speaker emails (confirmations, accept/reject, reminders) AND
# auth magic codes. Required in production for the speaker portal login.
PYLON_EMAIL_PROVIDER=stack0
PYLON_EMAIL_API_KEY=sk_live_...
PYLON_EMAIL_FROM=speakers@yourdomain.com

# Public origin used in email links (portal links, calendar links).
PYLON_PUBLIC_URL=http://localhost:4321

# ── File uploads (headshots, slides) ─────────────────────────────────────────
# Local disk in dev; set stack0 (or s3) in production.
# PYLON_FILES_PROVIDER=stack0
# PYLON_STACK0_API_KEY=sk_live_...
# PYLON_STACK0_PROJECT_SLUG=your-project

# ── OAuth (optional, organizer login) ────────────────────────────────────────
# The login/signup pages show a Google button; set these to enable it.
# PYLON_OAUTH_GOOGLE_CLIENT_ID=...
# PYLON_OAUTH_GOOGLE_CLIENT_SECRET=...
# PYLON_OAUTH_GOOGLE_REDIRECT=http://localhost:4321/api/auth/callback/google
